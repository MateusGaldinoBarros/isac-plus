# Copie para .env.local e preencha com os dados do Neon (Connection string > JDBC)
DB_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# Storage de imagens (rodando ./mvnw spring-boot:run fora do Docker)
# Use os mesmos valores de STORAGE_ACCESS_KEY e STORAGE_SECRET_KEY do .env
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=isac-plus-imagens
S3_REGION=us-east-1
